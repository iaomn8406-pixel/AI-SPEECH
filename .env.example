# =========================================================================
# منصة نطق - متغيرات البيئة لإعداد المشروع على Vercel و Supabase
# AI Child Speech & Learning Platform - Environment Variables
# =========================================================================

# -------------------------------------------------------------------------
# 1. إعدادات Supabase (قاعدة البيانات والمصادقة)
# يتم الحصول عليها من: https://supabase.com -> Project Settings -> API
# -------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# -------------------------------------------------------------------------
# 2. مفاتيح الذكاء الاصطناعي (AI Providers)
# يمكن إدخالها هنا أو إدارتها مباشرة من لوحة الإدارة (Admin AI Settings)
# -------------------------------------------------------------------------
# Google Gemini API Key (احصل عليه مجاناً من https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy...

# OpenAI API Key (اختياري - https://platform.openai.com)
OPENAI_API_KEY=sk-...

# Anthropic Claude API Key (اختياري - https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------------------
# 3. إعدادات عامة للتطبيق
# -------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=نطق | AI Speech
NEXT_PUBLIC_APP_URL=https://ai-speech.vercel.app
NEXT_PUBLIC_DEFAULT_LOCALE=ar
